# Copy to <project>.env and fill it in. See Setup in README.md.
# The repositories PRDs may change, separated by commas.
EXOMECHA_REPOS=owner/name
EXOMECHA_BASE_BRANCH=main
EXOMECHA_GITHUB_TOKEN=github_pat_...

# The repository whose issues are the PRDs. Optional with one repository above, which then holds
# the PRDs too. Required with several.
# EXOMECHA_PRD_REPO=owner/plans

# Optional. A value sbx hands to the requests builder's and resolver's sandboxes send to the hosts,
# such as a read-only token for a private package registry. The sandbox holds only a placeholder in
# the environment variable named after the prefix. The hosts, separated by commas, then a space and
# a command on this machine that prints the value.
# EXOMECHA_SECRET_NPM_TOKEN=npm.pkg.github.com /usr/local/bin/npm-read-token

# Optional. Percent of the Claude plan's 5-hour and weekly limits.
# exomecha starts no new work at or above them.
# EXOMECHA_FIVE_HOUR_LIMIT=90
# EXOMECHA_WEEKLY_LIMIT=80

# Optional. How many PRD sandboxes builder and resolver may have at once.
# EXOMECHA_SANDBOX_LIMIT=2

# Optional. How many reviewer sandboxes, which only read the code, may exist at once.
# EXOMECHA_READ_SANDBOX_LIMIT=2

# Optional. How many times reviewer sends a PR back to builder before a person decides.
# EXOMECHA_REVIEW_LIMIT=5

# Optional. The claude model and effort of each tier, as model:effort.
# reviewer uses heavy, builder its PRD's tier label.
# EXOMECHA_TIER_LIGHT=opus:low
# EXOMECHA_TIER_NORMAL=opus:high
# EXOMECHA_TIER_HEAVY=opus:xhigh

# Optional. The claude model and effort of every resolver run, whatever the PRD's tier.
# EXOMECHA_RESOLVER_MODEL=opus:medium
