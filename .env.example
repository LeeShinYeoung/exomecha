# Copy to <project>.env and fill it in. See Setup in README.md.
EXOMECHA_REPO=owner/name
EXOMECHA_BASE_BRANCH=main
EXOMECHA_GITHUB_TOKEN=github_pat_...

# Optional. Percent of the Claude plan's 5-hour and weekly limits.
# exomecha starts no new work at or above them.
# EXOMECHA_FIVE_HOUR_LIMIT=90
# EXOMECHA_WEEKLY_LIMIT=80

# Optional. How many PRD sandboxes builder and resolver may have at once.
# EXOMECHA_SANDBOX_LIMIT=2

# Optional. How many reviewer sandboxes, which only read the code, may exist at once.
# EXOMECHA_READ_SANDBOX_LIMIT=2

# Optional. The claude model and effort of each tier, as model:effort.
# reviewer uses heavy, resolver light, builder its PRD's tier label.
# EXOMECHA_TIER_LIGHT=opus:low
# EXOMECHA_TIER_NORMAL=opus:high
# EXOMECHA_TIER_HEAVY=opus:xhigh
