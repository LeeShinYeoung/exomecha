# Copy to <project>.env and fill it in. See Setup in README.md.
EXOMECHA_REPO=owner/name
EXOMECHA_BASE_BRANCH=main
EXOMECHA_GITHUB_TOKEN=github_pat_...

# Optional. Percent of the Claude plan's 5-hour and weekly limits.
# exomecha starts no new work at or above them.
# EXOMECHA_FIVE_HOUR_LIMIT=90
# EXOMECHA_WEEKLY_LIMIT=80

# Optional. How many Task sandboxes builder and resolver may have at once.
# EXOMECHA_SANDBOX_LIMIT=2
