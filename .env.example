# Copy to <project>.env and fill it in. See Setup in README.md.
COWORKER_REPO=owner/name
COWORKER_BASE_BRANCH=main
COWORKER_GITHUB_TOKEN=github_pat_...

# Optional. Percent of the Claude plan's 5-hour and weekly limits.
# coworker starts no new work at or above them.
# COWORKER_FIVE_HOUR_LIMIT=90
# COWORKER_WEEKLY_LIMIT=80

# Optional. How many Task sandboxes builder and resolver may have at once.
# COWORKER_SANDBOX_LIMIT=2
